{
  "name": "@opulonjs/ui",
  "version": "0.1.0",
  "description": "Admin UI kit on Nuxt UI 4 for @opulonjs host apps",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpulonHQ/ts-packages.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@opulonjs/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./components/*": {
      "@opulonjs/source": "./src/components/*.vue",
      "types": "./dist/components/*.d.mts",
      "default": "./dist/components/*.mjs"
    },
    "./vite": {
      "@opulonjs/source": "./src/vite.ts",
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.142",
    "@iconify/vue": "5.0.3",
    "@nuxt/ui": "4.11.3"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "vite": "8.3.4",
    "vue-router": "5.4.0"
  }
}
