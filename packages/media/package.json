{
  "name": "@opulonjs/media",
  "version": "0.0.0",
  "description": "Media library on R2 for @opulonjs host apps: uploads, immutable serving, resized URLs",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpulonHQ/ts-packages.git",
    "directory": "packages/media"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@opulonjs/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./api": {
      "@opulonjs/source": "./src/api.ts",
      "types": "./dist/api.d.mts",
      "default": "./dist/api.mjs"
    },
    "./server": {
      "@opulonjs/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.mts",
      "default": "./dist/server/index.mjs"
    },
    "./admin": {
      "@opulonjs/source": "./src/admin/index.ts",
      "types": "./dist/admin/index.d.mts",
      "default": "./dist/admin/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@opulonjs/admin": "workspace:*",
    "@opulonjs/core": "workspace:*",
    "@opulonjs/ui": "workspace:*",
    "image-size": "2.0.4"
  },
  "peerDependencies": {
    "effect": "4.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "effect": "4.0.3"
  }
}
