{
  "name": "@opulonjs/core",
  "version": "0.0.0",
  "private": true,
  "description": "Module contract, composition, Workers adapter and migrator for @opulonjs packages",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpulonHQ/ts-packages.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@opulonjs/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./workers": {
      "@opulonjs/source": "./src/workers.ts",
      "types": "./dist/workers.d.mts",
      "default": "./dist/workers.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@effect/sql-pg": "4.0.3",
    "effect": "4.0.3"
  },
  "peerDependencies": {
    "@effect/sql-pg": "4.0.3",
    "effect": "4.0.3"
  },
  "bin": {
    "opulon": "./dist/cli.mjs"
  }
}
